<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="dae.me.javafx.controller.MainController"
            styleClass="root">

    <left>
        <VBox styleClass="sidebar" spacing="4" prefWidth="180">
            <padding>
                <Insets topRightBottomLeft="12"/>
            </padding>

            <Label text="AnimeBacklog" styleClass="sidebar-title"/>

            <Button text="Galeria" styleClass="nav-button"
                    onAction="#onGalleryClick" maxWidth="Infinity"/>
            <Button text="Nuevo Anime" styleClass="nav-button"
                    onAction="#onNewAnimeClick" maxWidth="Infinity"/>
            <Button text="Lista Animes" styleClass="nav-button"
                    onAction="#onAnimesClick" maxWidth="Infinity"/>
            <Button text="Categorias" styleClass="nav-button"
                    onAction="#onCategoriesClick" maxWidth="Infinity"/>

            <Label text="Buscar en Jikan" styleClass="sidebar-title"/>

            <Button text="Importar de Jikan" styleClass="nav-button"
                    onAction="#onJikanImportClick" maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea" styleClass="content-area">
            <Label text="Bienvenido a AnimeBacklog" styleClass="placeholder-text"/>
        </StackPane>
    </center>

</BorderPane>
